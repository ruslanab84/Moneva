<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #F6F4F0; color: #1C1A17; font-family: "Schibsted Grotesk", system-ui, -apple-system, "Helvetica Neue", sans-serif; -webkit-font-smoothing: antialiased; }
    a { color: #24544A; text-decoration: none; } a:hover { color: #173832; }
    .screen { width: 390px; height: 844px; background: #F6F4F0; position: relative; overflow: hidden; display: flex; flex-direction: column; }
    .body { display: flex; flex-direction: column; gap: 14px; padding: 58px 20px 0; }
    .serif { font-family: "Instrument Serif", Georgia, "Times New Roman", serif; font-weight: 400; }
    .amount { font-family: "Instrument Serif", Georgia, serif; font-size: 50px; line-height: 1.02; letter-spacing: -0.012em; }
    .card { background: #FFFFFF; border-radius: 24px; padding: 18px; box-shadow: 0 1px 2px rgba(28,26,23,.05), 0 14px 30px -20px rgba(28,26,23,.35); }
    .muted { color: #6E6860; }
    .eyebrow { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #726C61; font-weight: 600; }
    .row { display: flex; align-items: center; gap: 12px; }
    .col { display: flex; flex-direction: column; gap: 4px; }
    .stack { display: flex; flex-direction: column; gap: 12px; }
    .grow { flex-grow: 1; }
    .tile { width: 44px; height: 44px; border-radius: 15px; display: flex; align-items: center; justify-content: center; flex: none; }
    .bar { height: 8px; border-radius: 99px; background: #E8E4DC; overflow: hidden; }
    .bar > i { display: block; height: 100%; border-radius: 99px; background: #24544A; }
    .nav { position: absolute; left: 20px; right: 20px; bottom: 26px; height: 64px; border-radius: 24px; background: rgba(255,255,255,.9); backdrop-filter: blur(20px); border: 1px solid #E8E4DC; display: flex; align-items: center; justify-content: space-around; box-shadow: 0 18px 40px -22px rgba(28,26,23,.55); }
    .navitem { width: 44px; height: 44px; border-radius: 14px; display: flex; align-items: center; justify-content: center; color: #726C61; }
    .navitem.on { color: #24544A; background: #EAF0ED; }
    .fab { position: absolute; right: 24px; bottom: 104px; width: 60px; height: 60px; border-radius: 21px; background: #24544A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; box-shadow: 0 16px 30px -14px rgba(36,84,74,.75); }
    .btn { height: 52px; border-radius: 18px; display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 16px; font-weight: 600; }
    .btn-p { background: #24544A; color: #FFFFFF; }
    .btn-s { background: #EFEBE4; color: #1C1A17; }
    .chip { height: 36px; padding: 0 14px; border-radius: 12px; display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 500; background: #EFEBE4; color: #57524A; }
    .chip.on { background: #24544A; color: #FFFFFF; }
    .seg { display: flex; gap: 4px; padding: 4px; background: #EAE6DF; border-radius: 16px; }
    .seg > div { flex-grow: 1; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 14px; font-weight: 600; color: #6E6860; }
    .seg > div.on { background: #FFFFFF; color: #1C1A17; box-shadow: 0 1px 3px rgba(28,26,23,.12); }
    .sheet { position: absolute; left: 0; right: 0; bottom: 0; background: #FFFFFF; border-radius: 30px 30px 0 0; padding: 12px 20px 30px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 -24px 60px -30px rgba(28,26,23,.7); }
    .grip { width: 38px; height: 5px; border-radius: 99px; background: #DDD8CF; align-self: center; }
    .divide { height: 1px; background: #EDE9E1; }
    .field { background: #F6F4F0; border: 1px solid #E8E4DC; border-radius: 14px; padding: 10px 14px; display: flex; flex-direction: column; gap: 2px; }
    .lbl { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: #726C61; font-weight: 600; }
    .val { font-size: 16px; font-weight: 600; }
    svg { display: block; }
  </style>
</helmet>
